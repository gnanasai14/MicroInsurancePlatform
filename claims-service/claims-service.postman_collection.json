{
  "info": {
    "name": "claims-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "claimsServiceUrl", "value": "http://localhost:8083" }
  ],
  "item": [
    {
      "name": "Submit Claim (clean)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{claimsServiceUrl}}/api/claims",
          "host": ["{{claimsServiceUrl}}"],
          "path": ["api", "claims"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"policyId\": 1,\n  \"userId\": 2,\n  \"claimedAmount\": 250.00,\n  \"description\": \"Lost baggage during connecting flight\"\n}"
        }
      }
    },
    {
      "name": "Submit Claim (will auto-flag)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{claimsServiceUrl}}/api/claims",
          "host": ["{{claimsServiceUrl}}"],
          "path": ["api", "claims"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"policyId\": 1,\n  \"userId\": 2,\n  \"claimedAmount\": 75000.00\n}"
        }
      }
    },
    {
      "name": "Get Claim by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{claimsServiceUrl}}/api/claims/1",
          "host": ["{{claimsServiceUrl}}"],
          "path": ["api", "claims", "1"]
        }
      }
    },
    {
      "name": "Get Claims by Policy ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{claimsServiceUrl}}/api/claims/policy/1",
          "host": ["{{claimsServiceUrl}}"],
          "path": ["api", "claims", "policy", "1"]
        }
      }
    },
    {
      "name": "Get Claims by User ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{claimsServiceUrl}}/api/claims/user/2",
          "host": ["{{claimsServiceUrl}}"],
          "path": ["api", "claims", "user", "2"]
        }
      }
    },
    {
      "name": "Update Claim Status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{claimsServiceUrl}}/api/claims/1/status",
          "host": ["{{claimsServiceUrl}}"],
          "path": ["api", "claims", "1", "status"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"newStatus\": \"UNDER_REVIEW\",\n  \"note\": \"Assigned to underwriter\"\n}"
        }
      }
    },
    {
      "name": "Get Fraud Flags",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{claimsServiceUrl}}/api/risk/claims/2/flags",
          "host": ["{{claimsServiceUrl}}"],
          "path": ["api", "risk", "claims", "2", "flags"]
        }
      }
    },
    {
      "name": "Get Risk Score",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{claimsServiceUrl}}/api/risk/claims/1/score",
          "host": ["{{claimsServiceUrl}}"],
          "path": ["api", "risk", "claims", "1", "score"]
        }
      }
    }
  ]
}
